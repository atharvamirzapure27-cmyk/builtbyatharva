# BuiltByAtharva Environment Variables
# Configure these in your Netlify Dashboard:
# Site Configuration > Environment variables

# [REQUIRED] Your secret Resend API Key (starts with 're_')
# Generate at: https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_api_key_here

# [OPTIONAL] Business email address where new client enquiry briefs are delivered
# Defaults to: builtbyatharva27@gmail.com
CONTACT_EMAIL=builtbyatharva27@gmail.com

# [OPTIONAL] The 'From' sender address
# For testing: onboarding@resend.dev (Note: Resend's test sender only delivers to your registered Resend account email)
# For production: BuiltByAtharva Studio <enquiry@yourverifieddomain.com> (Requires domain verification in Resend)
RESEND_FROM_EMAIL=BuiltByAtharva Studio <onboarding@resend.dev>

# [OPTIONAL] Set to 'true' to send an automated confirmation receipt to the client
# Leave as 'false' unless you have verified a custom domain in Resend
RESEND_CLIENT_CONFIRMATION=false
